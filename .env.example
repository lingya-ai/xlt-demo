# 复制为 .env.local 后填写。AK/SK 只放在服务端环境中，不要提交到 Git。
# OpenAPI 网关地址，保留实际租户域名；不要填平台控制台地址。
OPENAPI_BASE_URL=https://your-tenant.example.com
OPENAPI_CHANNEL_ID=your-openapi-channel-id
OPENAPI_AK=your-access-key
OPENAPI_SK=your-secret-key
# 示例用户的稳定标识。正式接入时由宿主登录态确定，不要信任浏览器传入。
OPENAPI_EXTERNAL_USER_ID=demo-user
